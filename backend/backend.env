# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (required) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mock-interview

# --- Auth (required) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ISSUER=mock-interview-platform
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated list of allowed origins. Falls back to FRONTEND_URL if unset.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- AI providers (at least one recommended; app boots without them but AI features fail at runtime) ---
AI_PROVIDER_PRIMARY=gemini
AI_REQUEST_TIMEOUT_MS=120000
AI_REQUEST_RETRY_ATTEMPTS=2

GEMINI_API_KEY=
GEMINI_API_URL=
GEMINI_DEFAULT_MODEL=
AI_RESUME_MODEL=
AI_RESUME_WEAKNESS_MODEL=
AI_JD_ANALYSIS_MODEL=

GROQ_API_KEY=
GROQ_API_URL=
GROQ_DEFAULT_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_API_URL=
OPENROUTER_DEFAULT_MODEL=

# --- Cloudinary (needed for resume/JD/avatar uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Upload limits (bytes) ---
RESUME_MAX_SIZE_BYTES=5242880
AVATAR_MAX_SIZE_BYTES=2097152
UPLOAD_MAX_SIZE_BYTES=10485760

# --- Reserved for upcoming milestones (not yet used) ---
JUDGE0_URL=
